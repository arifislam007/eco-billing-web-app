generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MonthStatus {
  open
  closed
}

enum Role {
  admin
  staff
}

/// Single row (id fixed to "singleton") holding app-wide toggles admin can
/// flip from the UI - starts as one flag (Monthly Report for staff) but the
/// pattern extends to more without a schema change if that flag is ever a
/// json blob instead. Kept as an explicit boolean column while there's only one.
model AppSettings {
  id                      String  @id @default("singleton")
  allowStaffMonthlyReport Boolean @default(false)
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(admin)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  collectionEntries CollectionEntry[]
}

model Partner {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries           PartnerMonthEntry[]
  deposits          Deposit[]
  collectionEntries CollectionEntry[]
}

model Month {
  id        String      @id @default(cuid())
  label     String      @unique // e.g. "July-26"
  year      Int
  month     Int // 1-12
  status    MonthStatus @default(open)
  createdAt DateTime    @default(now())

  entries           PartnerMonthEntry[]
  deposits          Deposit[]
  costItems         CostItem[]
  transactions      Transaction[]
  collectionEntries CollectionEntry[]

  @@unique([year, month])
}

/// Admin-set parameters for a partner's month. Total users/collection are
/// NOT stored here anymore - they're the sum of that partner+month's
/// CollectionEntry rows (see below), same pattern as Deposit -> totalDeposit.
model PartnerMonthEntry {
  id        String @id @default(cuid())
  partnerId String
  monthId   String

  commissionPct Decimal @default(0.45) @db.Decimal(6, 4)
  bonusPct      Decimal @default(0) @db.Decimal(6, 4)
  discount      Decimal @default(0) @db.Decimal(14, 2)
  lastMonthDue  Decimal @default(0) @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  month   Month   @relation(fields: [monthId], references: [id], onDelete: Cascade)

  @@unique([partnerId, monthId])
}

/// One row per submission. Staff can only INSERT (call it in as many times
/// as needed during the month); editing/deleting an existing row is
/// admin-only. A partner's effective totalUsers/totalCollection for the
/// month is Σ these rows.
model CollectionEntry {
  id         String   @id @default(cuid())
  partnerId  String
  monthId    String
  users      Int
  collection Decimal  @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now())

  createdByUserId String?
  createdBy       User?   @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  month   Month   @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Deposit {
  id        String   @id @default(cuid())
  partnerId String
  monthId   String
  date      DateTime @default(now())
  amount    Decimal  @db.Decimal(14, 2)
  medium    String   @default("cash") // cash | bkash | bank
  ref       String?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  month   Month   @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model CostItem {
  id        String  @id @default(cuid())
  monthId   String
  label     String
  amount    Decimal @db.Decimal(14, 2)
  note      String?
  isComputedBonus Boolean @default(false)

  month Month @relation(fields: [monthId], references: [id], onDelete: Cascade)
}

model Transaction {
  id      String   @id @default(cuid())
  monthId String?
  date    DateTime @default(now())
  details String
  send    Decimal  @default(0) @db.Decimal(14, 2)
  receive Decimal  @default(0) @db.Decimal(14, 2)
  comment String?

  month Month? @relation(fields: [monthId], references: [id], onDelete: SetNull)
}
